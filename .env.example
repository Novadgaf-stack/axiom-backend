# ============================================================
# Copy this file to .env for local development.
# On Render, set these under the service's Environment tab —
# never commit a real .env file.
# ============================================================

# --- Binance ---
# Generate testnet keys at https://testnet.binance.vision (log in with GitHub).
# These are SEPARATE from your real Binance account keys.
BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_api_secret
# Keep this true. Only ever set to false as a deliberate, reviewed decision
# once you have independently tested and are ready to risk real funds.
BINANCE_TESTNET=true

# --- Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# --- Trading universe ---
TRADING_PAIRS=BTC/USDT,ETH/USDT
TIMEFRAME=15m
OHLCV_LOOKBACK=200
POLL_INTERVAL_SECONDS=60

# --- Decision gating ---
MIN_CONFIDENCE_SCORE=85
REQUIRE_TECHNICAL_CONFIRMATION=true

# --- Risk management ---
RISK_PER_TRADE_PCT=0.5
MAX_POSITION_PCT=10
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=3
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0
# Minimum volume vs 20-period average required for a technical bias to count
# (filters out signals on abnormally dead/illiquid candles)
MIN_VOLUME_RATIO=0.7
# After a losing trade closes, block new entries on that symbol for this long
COOLDOWN_MINUTES_AFTER_LOSS=30
# Entry orders are marketable limits capped at this much worse than the
# observed price, instead of blind market orders
MAX_SLIPPAGE_PCT=0.15
# If live price has moved more than this % from the candle the signal was
# computed on, treat the signal as stale and skip rather than trade on it
MAX_PRICE_STALENESS_PCT=1.0
MIN_TRADE_NOTIONAL_USD=10

# --- Safety switches ---
# TRADING_ENABLED=false lets the engine run, log data, and call Gemini
# without ever sending an order — useful for a first observation period.
TRADING_ENABLED=true
DRY_RUN=false

# --- API / infra ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=change_me_to_a_long_random_value
ALLOWED_ORIGINS=https://nexus-7-weex-terminal.vercel.app,http://localhost:3000,http://localhost:5173
DATABASE_PATH=./data/engine.db
LOG_LEVEL=INFO
PORT=10000
